{
  "name": "football-matches-api",
  "version": "1.0.0",
  "description": "API backend for football matches",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node server",
    "dev": "nodemon server",
    "lint": "eslint .",
    "test": "jest --reporters=default --reporters=jest-junit",
    "test_console": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:thulin82/football-matches-api.git"
  },
  "author": "Markus Thulin",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.0",
    "dotenv": "^17.4.0",
    "express": "^5.2.0",
    "mongoose": "^9.9.0",
    "morgan": "^1.11.0",
    "node-geocoder": "^4.4.0",
    "slugify": "^1.6.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "babel-jest": "^30.4.0",
    "eslint": "^10.8.0",
    "globals": "17.11.0",
    "jest": "^30.4.0",
    "jest-junit": "17.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.0"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
